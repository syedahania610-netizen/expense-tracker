# Database Configuration (Supabase / PostgreSQL)
# You can provide either a single DATABASE_URL or individual host connection parameters:
DATABASE_URL=
SUPABASE_DB_URL=

# Or standard PostgreSQL host configuration:
SQL_HOST=
SQL_DB_NAME=
SQL_USER=
SQL_PASSWORD=
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=

# Supabase Client configuration (optional for client-direct integration)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
